<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id='view_account_payment_form_seniat_custom' model='ir.ui.view'>
            <field name='name'>account.payment.form.seniat.custom</field>
            <field name='model'>account.payment</field>
            <field name='inherit_id' ref='account_dual_currency.account_payment_dual_currency'/>
            <field name='arch' type='xml'>

                <xpath expr='//field[@name="amount"]' position='after'>
                    <field name='company_currency_id' invisible='1'/>
                    <field name='amount_bs_reference_custom' 
                           invisible='currency_id == company_currency_id'
                           force_save='1'/>
                </xpath>

                <xpath expr='//field[@name="mount_igtf"]' position='after'>
                    <field name='igtf_bs_reference_custom' 
                           invisible='currency_id == company_currency_id'
                           force_save='1'/>
                </xpath>

                <xpath expr='//field[@name="amount_total_pagar"]' position='after'>
                    <div class='o_td_label'>
                        <label for='total_bs_reference_custom' string='Total Ref. (Bs)' invisible='currency_id == company_currency_id'/>
                    </div>
                    <field name='total_bs_reference_custom' 
                           nolabel='1'
                           invisible='currency_id == company_currency_id'
                           style='font-weight: bold;'
                           force_save='1'/>
                </xpath>

                <xpath expr='//field[@name="aplicar_igtf_divisa"]' position='attributes'>
                    <attribute name='readonly'>currency_id != company_currency_id</attribute>
                    <attribute name='force_save'>1</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
