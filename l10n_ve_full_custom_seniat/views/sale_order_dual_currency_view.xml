<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id='view_order_form_dual_currency_extension' model='ir.ui.view'>
            <field name='name'>sale.order.form.dual.currency.extension</field>
            <field name='model'>sale.order</field>
            <field name='inherit_id' ref='sale.view_order_form'/>
            <field name='arch' type='xml'>

                <xpath expr="//sheet" position="before">
                    <field name='company_currency_id' invisible='1'/>
                    <field name='currency_id_dif' invisible='1'/>
                </xpath>

                <xpath expr="//field[@name='name']" position="before">
                    
                    <div style="float: right; margin-bottom: 10px;">
                        <span class="badge rounded-pill text-danger border border-danger bg-white"
                              style="font-size: 13px; font-weight: 500; padding: 6px 12px; margin-top: 4px;">
                            <i class="fa fa-ban" style="margin-right: 5px;"/>
                            Sin derecho a crédito fiscal
                        </span>
                    </div>

                    <h1 class="font-weight-bold" invisible="state != 'draft'">
                        Presupuesto
                    </h1>
                    <h1 class="font-weight-bold" invisible="state != 'sent'">
                        Cotización
                    </h1>
                    <h1 class="font-weight-bold" invisible="state != 'sale'">
                        Pedido de Venta
                    </h1>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name='string'>Cliente / Razón Social</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name='string'>Número de Cotización</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name='tax_today' invisible='1' string='Tasa Factura'/>
                </xpath>

                <xpath expr="//field[@name='note']" position="before">
                    <group name='sale_total_ves_ref' invisible="1" />
                    <group name='sale_total_usd_ref' invisible="1" />
                </xpath>

            </field>
        </record>
    </data>
</odoo>
