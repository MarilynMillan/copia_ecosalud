<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id='view_sale_advance_payment_inv_seniat_warning' model='ir.ui.view'>
        <field name='name'>sale.advance.payment.inv.seniat.warning</field>
        <field name='model'>sale.advance.payment.inv</field>
        <field name='inherit_id' ref='sale.view_sale_advance_payment_inv'/>
        <field name='arch' type='xml'>
            
            <xpath expr='//group' position='before'>
                <div class='alert alert-warning' role='alert' style='margin-bottom: 20px; border-left: 5px solid #ffc107;'>
                    <div class='d-flex'>
                        <div style='margin-right: 15px;'>
                            <i class='fa fa-exclamation-triangle fa-2x' style='color: #856404;'></i>
                        </div>
                        <div>
                            <h4 class='alert-heading' style='font-weight: bold; font-size: 15px; color: #856404; margin-bottom: 5px;'>
                                VERIFICACIÓN DE DATOS PRE-FACTURA
                            </h4>
                            <p style='font-size: 13px; margin-bottom: 5px;'>
                                Antes de generar el borrador, por favor confirme los siguientes puntos críticos:
                            </p>
                            <ul style='font-size: 13px; margin-bottom: 0; padding-left: 20px;'>
                                <li>¿El <b>Cliente</b> y su <b>RIF</b> son correctos?</li>
                                <li>¿La <b>Tasa de Cambio</b> del sistema está actualizada?</li>
                                <li>¿Los <b>Precios y Cantidades</b> son definitivos?</li>
                            </ul>
                            <div style='margin-top: 8px; font-size: 12px; color: #666; font-style: italic; border-top: 1px solid #faeace; padding-top: 5px;'>
                                <i class='fa fa-info-circle'/> Nota: El <b>Número de Control</b> se asignará automáticamente consecutivamente al crear el borrador.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
