<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id='view_account_annulment_reason_tree' model='ir.ui.view'>
        <field name='name'>account.annulment.reason.tree</field>
        <field name='model'>account.annulment.reason</field>
        <field name='arch' type='xml'>
            <tree string='Motivos de Corrección de Factura' editable='bottom'>
                <field name='sequence' widget='handle'/>
                <field name='name'/>
                <field name='description'/>
                <field name='active' widget='boolean_toggle'/>
            </tree>
        </field>
    </record>

    <record id='action_account_annulment_reason' model='ir.actions.act_window'>
        <field name='name'>Motivos de Corrección de Factura</field>
        <field name='res_model'>account.annulment.reason</field>
        <field name='view_mode'>tree</field>
        <field name='help' type='html'>
          <p class='o_view_nocontent_smiling_face'>
            Defina los motivos estandarizados para justificar la corrección de facturas.
          </p>
        </field>
    </record>

    <menuitem id='menu_seniat_homologation_root'
              name='Homologación Fiscal Venezuela (SENIAT)'
              parent='account.menu_finance_configuration'
              sequence='100'
              groups='l10n_ve_full_custom_seniat.group_seniat_manager'/>

    <menuitem id='menu_account_annulment_reason'
              parent='menu_seniat_homologation_root'
              action='action_account_annulment_reason'
              name='Motivos de Corrección de Factura'
              sequence='10'/>

</odoo>
