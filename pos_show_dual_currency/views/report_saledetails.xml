<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="pos_daily_report" inherit_id="point_of_sale.report_saledetails">
       <xpath expr="//div[@id='sales']//table/tbody/tr/tr/td[3]" position="replace">
            <td class="text-end">
                <t t-out='line["base_amount"]' t-options="{'widget': 'float', 'precision': currency['precision']}"/>
                <t t-out='currency["symbol"]'/>
                /
                <span style="color: red">
                    <t t-esc='symbol_ref'/>
                    <t t-esc='line.get("base_amount_ref", 0)' t-options="{'widget': 'float', 'precision': currency_precision_ref}"/>
                </span>

                <t t-if='line.get("discount") != 0'>
                    <br/>Disc: <t t-out='line["discount"]'/>%
                </t>
            </td>
        </xpath>

        <xpath expr="//t[@id='other_payments']//table/tbody/tr" position="replace">
            <tr t-foreach='payments' t-as='payment'>
                <td>
                    <t t-out="payment['name']"/>
                </td>
                <td class="text-end">
                    <t t-out="payment['total']" t-options="{'widget': 'float', 'precision': currency['precision']}"/>
                    <t t-out='currency["symbol"]'/>
                    /
                    <span style="color: red">
                        <t t-esc='symbol_ref'/>
                        <t t-esc="payment.get('total_ref', 0)" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/>
                    </span>
                </td>
            </tr>
        </xpath>

        <xpath expr="//t[@id='taxe_sales']//table/tbody/tr[@t-as='tax']" position="replace">
            <tr t-foreach='taxes' t-as='tax'>
                <td>
                    <t t-out="tax['name']"/>
                </td>
                <td class="text-end">
                    <t t-out="tax['tax_amount']" t-options="{'widget': 'float', 'precision': currency['precision']}"/>
                    <t t-out='currency["symbol"]'/>
                    /
                    <span style="color: red">
                        <t t-esc='symbol_ref'/>
                        <t t-esc="tax.get('tax_amount_ref', 0)" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/>
                    </span>
                </td>
                <td class="text-end">
                    <t t-out="tax['base_amount']" t-options="{'widget': 'float', 'precision': currency['precision']}"/>
                    <t t-out='currency["symbol"]'/>
                    /
                    <span style="color: red">
                        <t t-esc='symbol_ref'/>
                        <t t-esc="tax.get('base_amount_ref', 0)" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/>
                    </span>
                </td>
            </tr>
        </xpath>

        <xpath expr="//t[@id='closing_session']//div/strong/span[last()]" position="after">
            <br/>
            <span style="color: red">
                Total Ref: 
                <t t-esc='symbol_ref'/>
                <t t-esc="total_paid_ref" t-options="{'widget': 'float', 'precision': currency_precision_ref}"/>
            </span>
        </xpath>
    </template>
</odoo>