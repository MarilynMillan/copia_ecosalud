<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_dual_currency" model="ir.ui.view">
        <field name="name">res.config.settings.pos.dual.currency.diff.ref</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Target the field directly and position after. This assumes standard form layout. -->
            <xpath expr="//field[@name='pos_amount_authorized_diff']" position="after">
                <!-- Add a new line/div for the ref field -->
                <div class="content-group mt16" invisible="not pos_set_maximum_difference">
                    <label for="pos_amount_authorized_diff_ref" string="Diferencia autorizada $" class="fw-normal"/>
                    <field name="pos_amount_authorized_diff_ref"/>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
