<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="OrderlineReceipt" t-inherit="point_of_sale.OrderlineReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//span[hasclass('pos-receipt-right-align')]" position="before">
            <span class="pos-receipt-right-align" style="float: right; margin-right: 10px;">
                <t t-esc="env.pos.format_currency_no_symbol(line.get_price_with_tax_sec())"/>
            </span>
        </xpath>
    </t>

</templates>