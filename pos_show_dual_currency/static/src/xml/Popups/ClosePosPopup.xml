<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('close-pos-popup')]" position="inside">
            <t t-set="ref_rate"
               t-value="pos.pos_session.tax_today or (pos.config.show_currency_rate != 0 ? (1/pos.config.show_currency_rate) : 1)"/>
        </xpath>

        <xpath expr="//div[hasclass('total-orders')]//span[hasclass('amount')]" position="after">
            <span style="color:red;"> / </span>
            <span style="color:red;" t-esc="pos.format_currency_ref(props.orders_details.amount * ref_rate)"/>
        </xpath>

        <xpath expr="//td[@t-esc='env.utils.formatCurrency(props.default_cash_details.amount)']" position="replace">
            <td>
                <span t-esc="env.utils.formatCurrency(props.default_cash_details.amount)"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="pos.format_currency_ref(props.default_cash_details.amount * ref_rate)"/>
            </td>
        </xpath>

        <xpath expr="//td[@t-esc='env.utils.formatCurrency(getDifference(props.default_cash_details.id))']" position="replace">
            <td>
                <span t-esc="env.utils.formatCurrency(getDifference(props.default_cash_details.id))"
                      t-att-class="{'warning text-danger fw-bolder': !env.utils.floatIsZero(getDifference(props.default_cash_details.id))}"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="pos.format_currency_ref(getDifference(props.default_cash_details.id) * ref_rate)"/>
            </td>
        </xpath>

        <xpath expr="//tr[@t-foreach='props.other_payment_methods']//td[@t-esc='env.utils.formatCurrency(pm.amount)']" position="replace">
            <td>
                <span t-esc="env.utils.formatCurrency(pm.amount)"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="pos.format_currency_ref(pm.amount * ref_rate)"/>
            </td>
        </xpath>

        <xpath expr="//tbody[hasclass('cash-overview')]" position="before">
            <tbody t-if="pos.config.show_dual_currency">
                <tr style="background-color: #f8f9fa;">
                    <td>Efectivo Real ($)</td>
                    <td>
                        <span style="color:red;" t-esc="pos.format_currency_ref(props.default_cash_details.amount * ref_rate)"/>
                    </td>
                    <td class="d-flex">
                        <input class="form-control" type="number"
                               t-model.number="state.openingCashUSD"
                               t-on-input="handleInputChangeUSD"/>
                        <div class="button icon btn btn-secondary" t-on-click="openDetailsPopupUSD">
                            <i class="fa fa-calculator" role="img" title="Calculadora USD"/>
                        </div>
                    </td>
                    <td></td>
                </tr>
            </tbody>
        </xpath>

        <xpath expr="//div[hasclass('close-pos-popup')]" position="inside">
            <t t-if="state.displayMoneyDetailsPopupUSD">
                <MoneyDetailsPopupUSD
                    onConfirm="(payload) => this.updateCashOpeningUSD(payload)"
                    onDiscard="() => this.closeDetailsPopupUSD()"
                />
            </t>
        </xpath>

    </t>
</templates>