<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">

        <xpath expr="//div[hasclass('close-pos-popup')]" position="inside">
            <t t-set="ref_rate"
               t-value="env.services.pos.pos_session.tax_today or (env.services.pos.config.show_currency_rate != 0 ? (1/env.services.pos.config.show_currency_rate) : 1)"/>
        </xpath>

        <xpath expr="//div[hasclass('total-orders')]//span[hasclass('amount')]" position="after">
            <span style="color:red;"> / </span>
            <span style="color:red;" t-esc="env.services.pos.format_currency_ref(props.orders_details.amount * ref_rate)"/>
        </xpath>

        <!-- Update XPaths to match Odoo 17 ClosePosPopup structure (using env.utils.formatCurrency is deprecated/removed) -->
        <!-- In Odoo 17, ClosePosPopup uses formatCurrency from utils or similar. -->
        <!-- Since we don't have the base code, we'll try to target by structure where possible or use the new standard. -->
        <!-- However, without seeing the base code, the safest bet for a migration script is to try to match what we think is there. -->
        <!-- Standard Odoo 17 ClosePosPopup usually iterates payment methods. -->
        <!-- We will attempt to target the specific TD elements by their content logic if possible, or by structure. -->

        <!-- Target the cash details row -->
        <xpath expr="//div[hasclass('cash-overview')]//td[2]" position="replace">
             <td>
                <t t-esc="env.services.pos.format_currency(props.default_cash_details.amount)"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="env.services.pos.format_currency_ref(props.default_cash_details.amount * ref_rate)"/>
            </td>
        </xpath>

        <!-- Target the difference row (3rd column usually) -->
        <xpath expr="//div[hasclass('cash-overview')]//td[3]" position="replace">
             <td>
                <t t-esc="env.services.pos.format_currency(getDifference(props.default_cash_details.id))"
                   t-att-class="{'warning text-danger fw-bolder': Math.abs(getDifference(props.default_cash_details.id)) > 0.00001}"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="env.services.pos.format_currency_ref(getDifference(props.default_cash_details.id) * ref_rate)"/>
            </td>
        </xpath>

        <!-- Target other payment methods -->
        <!-- This is tricky without the exact t-esc. We'll assume the loop exists and target the amount cell. -->
         <xpath expr="//div[hasclass('payment-methods-overview')]//td[2]" position="replace">
            <td>
                <t t-esc="env.services.pos.format_currency(pm.amount)"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="env.services.pos.format_currency_ref(pm.amount * ref_rate)"/>
            </td>
        </xpath>

    </t>
</templates>
