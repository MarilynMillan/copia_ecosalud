<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">

        <xpath expr="//div[hasclass('close-pos-popup')]" position="inside">
            <t t-set="ref_rate"
               t-value="env.services.pos.pos_session.tax_today or (env.services.pos.config.show_currency_rate != 0 ? (1/env.services.pos.config.show_currency_rate) : 1)"/>
        </xpath>

        <xpath expr="//div[hasclass('total-orders')]//span[hasclass('amount')]" position="after">
            <span style="color:red;"> / </span>
            <span style="color:red;" t-esc="env.services.pos.format_currency_ref(props.orders_details.amount * ref_rate)"/>
        </xpath>

        <!-- Assuming base template uses 'env.utils.formatCurrency' or similar in expr. If not, these xpaths will fail. -->
        <!-- Since I can't check base template, I keep expr as provided but update content. -->

        <xpath expr="//td[@t-esc='env.utils.formatCurrency(props.default_cash_details.amount)']" position="replace">
            <td>
                <span t-esc="env.services.pos.format_currency(props.default_cash_details.amount)"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="env.services.pos.format_currency_ref(props.default_cash_details.amount * ref_rate)"/>
            </td>
        </xpath>

        <xpath expr="//td[@t-esc='env.utils.formatCurrency(getDifference(props.default_cash_details.id))']" position="replace">
            <td>
                <!-- Replaced env.utils.floatIsZero with Math.abs check approximation -->
                <span t-esc="env.services.pos.format_currency(getDifference(props.default_cash_details.id))"
                      t-att-class="{'warning text-danger fw-bolder': Math.abs(getDifference(props.default_cash_details.id)) > 0.00001}"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="env.services.pos.format_currency_ref(getDifference(props.default_cash_details.id) * ref_rate)"/>
            </td>
        </xpath>

        <xpath expr="//tr[@t-foreach='props.other_payment_methods']//td[@t-esc='env.utils.formatCurrency(pm.amount)']" position="replace">
            <td>
                <span t-esc="env.services.pos.format_currency(pm.amount)"/>
                <span style="color:red;"> / </span>
                <span style="color:red;" t-esc="env.services.pos.format_currency_ref(pm.amount * ref_rate)"/>
            </td>
        </xpath>

