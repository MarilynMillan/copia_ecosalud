/** @odoo-module */

// 1. Importaciones de Odoo v17
import { OrderReceipt } from "@point_of_sale/app/screens/receipt_screen/receipt/order_receipt";
import { patch } from "@web/core/utils/patch";
import { xml } from "@odoo/owl";

// 2. Parcheamos la plantilla (el .XML) de OrderReceipt
patch(OrderReceipt, {
    template: xml`
        <t t-patch="OrderReceipt" t-patch-mode="append">
            
            <xpath expr="//div[hasclass('total-due')]/span[hasclass('pos-receipt-right-align')]" position="before">
                <span class="pos-receipt-right-align" style="float: right; margin-right: 10px;">
                    <t t-esc="env.pos.format_currency_no_symbol(props.order.get_total_with_tax_sec())"/>
                </span>
            </xpath>

            <xpath expr="//div[hasclass('change')]/span[hasclass('pos-receipt-right-align')]" position="before">
                <span class="pos-receipt-right-align" style="float: right; margin-right: 10px;">
                    <t t-esc="env.pos.format_currency_no_symbol(props.order.get_change_sec())"/>
                </span>
            </xpath>

            <xpath expr="//div[hasclass('payment-line-name')]" position="after">
                <span class="pos-receipt-right-align" style="float: right; margin-right: 10px;">
                    <t t-esc="env.pos.format_currency_no_symbol(paymentline.get_amount() * env.pos.currency_sec_rate)"/>
                </span>
            </xpath>
        </t>
    `,
});