<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extend ProductCard to show dual currency price -->
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('price-tag')]" position="after">
            <t t-if="env.services.pos.config.show_dual_currency">
                <t t-set="ref_rate"
                   t-value="env.services.pos.pos_session.tax_today or (env.services.pos.config.show_currency_rate != 0 ? (1/env.services.pos.config.show_currency_rate) : 1)"/>
                
                <t t-set="price_ref" t-value="props.product.get_display_price(env.services.pos.default_pricelist, 1) * ref_rate"/>

                <span class="price-tag dual-currency" style="color: red; font-size: 0.8em; margin-left: 3px;">
                    / <t t-esc="env.services.pos.format_currency_ref(price_ref)"/>
                </span>
            </t>
        </xpath>
    </t>

    <!-- Extend Orderline to show dual currency price -->
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('price')]" position="inside">
            <t t-if="env.services.pos.config.show_dual_currency">
                <t t-set="ref_rate" t-value="env.services.pos.pos_session.tax_today or (env.services.pos.config.show_currency_rate != 0 ? (1/env.services.pos.config.show_currency_rate) : 1)"/>
                <t t-set="subtotal_ref" t-value="(props.line.get_unit_display_price ? props.line.get_unit_display_price() : (props.line.price || 0)) * ref_rate"/>
                <div class="dual-currency-line" style="color:red; font-size: 0.8em; font-weight: bold;">
                    / <t t-esc="env.services.pos.format_currency_ref(subtotal_ref)"/>
                </div>
            </t>
        </xpath>
    </t>

    <!-- Extend OrderWidget to show dual currency total -->
    <t t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]" position="inside">
            <t t-if="env.services.pos.config.show_dual_currency">
                <div class="total-ref" style="color:red; font-size: 1.2rem; margin-top: 5px; font-weight: bold; text-align: right; padding-right: 15px;">
                     / <t t-esc="total_ref"/>
                </div>
                 <div class="tax-ref" style="color:red; font-size: 0.8rem; font-weight: bold; text-align: right; padding-right: 15px;">
                     Impuestos: / <t t-esc="tax_ref"/>
                </div>
            </t>
        </xpath>
    </t>

</templates>
