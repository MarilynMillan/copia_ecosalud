<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">

        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="after">
            <div t-if="props.data.total_with_tax_ref" class="pos-receipt-amount" style="color:red; font-size: 0.8em;">
                Ref: <t t-esc="props.data.total_with_tax_ref"/>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('receipt-change')]" position="inside">
             <span t-if="props.data.change_ref" class="pos-receipt-right-align" style="color:red;">
                / <t t-esc="props.data.change_ref"/>
            </span>
        </xpath>

    </t>

</templates>