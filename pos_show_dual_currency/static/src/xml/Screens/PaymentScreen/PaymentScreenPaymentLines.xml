<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

   <t t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-amount')]" position="inside">
            <t t-if="pos.config.show_dual_currency">
                <span style="color:red; margin-left: 5px;"> / </span>
                <span style="color:red;" t-esc="formatLineAmountUsd(line)"/>
            </t>
        </xpath>
    </t>

</templates>