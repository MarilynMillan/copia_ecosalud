<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension" owl="1">
        <!-- Inserta después del monto principal (último <t> dentro de payment-amount) -->
        <xpath expr="//div[hasclass('payment-amount')]/t[last()]" position="after">
            <span style="color:red;"> / </span>
            <span style="color:red;" t-esc="formatLineAmountUsd(line)"/>
        </xpath>
    </t>

</templates>