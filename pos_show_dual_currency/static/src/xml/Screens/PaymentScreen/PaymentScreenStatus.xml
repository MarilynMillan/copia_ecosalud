<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension" owl="1">

        <xpath expr="//div[hasclass('total')]" position="inside">
             <t t-if="env.services.pos.config.show_dual_currency">
                <t t-set="ref_rate" t-value="env.services.pos.pos_session.tax_today or (env.services.pos.config.show_currency_rate != 0 ? (1/env.services.pos.config.show_currency_rate) : 1)"/>
                <div class="total-dual" style="color: red; font-size: 0.8em; margin-top: 5px;">
                     / <t t-esc="env.services.pos.format_currency_ref(props.order.get_due() * ref_rate)"/>
                </div>
            </t>
        </xpath>

    </t>
</templates>
