<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_show_dual_currency.CashMoveButtonRefCurrency" owl="1">
        <li class="menu-item navbar-button" t-on-click="onClickUSD">
            <a class="dropdown-item py-2">
                <i class="fa fa-money me-2" aria-hidden="true"></i>
                <span>Efectivo $ IN/OUT</span>
            </a>
        </li>
    </t>

    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//li[contains(@t-on-click, 'onCashMoveButtonClick')]" position="after">
            <CashMoveButtonRefCurrency t-if="env.services.pos.config.show_dual_currency"/>
        </xpath>
    </t>

</templates>