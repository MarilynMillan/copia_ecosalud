/** @odoo-module */

import { OrderReceipt } from "@point_of_sale/app/screens/receipt_screen/receipt/order_receipt";
import { patch } from "@web/core/utils/patch";
import { xml } from "@odoo/owl";

patch(OrderReceipt, {
    template: xml`
        <t t-patch="OrderReceipt" t-patch-mode="append">
            <t t-set="ref_rate"
               t-value="env.pos.pos_session.tax_today or (env.pos.config.show_currency_rate != 0 ? (1/env.pos.config.show_currency_rate) : 1)"/>

            <xpath expr="//div[hasclass('total-due')]/span[hasclass('pos-receipt-right-align')]" position="before">
                <span class="pos-receipt-right-align" style="float:right; margin-right:10px; color:red;">
                    <t t-esc="env.pos.format_currency_ref(props.order.get_total_with_tax() * ref_rate)"/>
                </span>
            </xpath>

            <xpath expr="//div[hasclass('change')]/span[hasclass('pos-receipt-right-align')]" position="before">
                <span class="pos-receipt-right-align" style="float:right; margin-right:10px; color:red;">
                    <t t-esc="env.pos.format_currency_ref(props.order.get_change() * ref_rate)"/>
                </span>
            </xpath>

            <xpath expr="//div[hasclass('payment-line-name')]" position="after">
                <span class="pos-receipt-right-align" style="float:right; margin-right:10px; color:red;">
                    <t t-esc="env.pos.format_currency_ref(paymentline.get_amount() * ref_rate)"/>
                </span>
            </xpath>
        </t>
    `,
});