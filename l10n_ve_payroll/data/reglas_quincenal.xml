        <record id="rule_SQUIN_quincenal" model="hr.salary.rule">
            <field name="name">Salario básico quincenal</field>
            <field name="code">SQUIN</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
monto = contract.wage if not contract.basado_usd else contract.wage_usd * payslip.tasa_cambio
WORK100 = worked_days['WORK100'].number_of_days if 'WORK100' in worked_days else 0
AUSEP = worked_days['AUSEP'].number_of_days if 'AUSEP' in worked_days else 0
result = (monto / 30) * (WORK100 + AUSEP)
            </field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="sequence" eval="1"/>
            <field name="struct_id" ref="structure_quincenal"/>
        </record>

