<?xml version='1.0' encoding='UTF-8'?>
<odoo>
	<record model="ir.ui.view" id="l10n_res_bank_form_inherit">
		<field name="name">l10n.res.bank.form_.inherit</field>
		<field name="model">res.partner.bank</field>
		<field name="inherit_id" ref="account.view_partner_bank_form_inherit_account"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='acc_number']" position="before">
                <field name="account_type" widget="radio" required="1" options="{'horizontal': True}"/>
			</xpath>
		</field>
	</record>
</odoo>