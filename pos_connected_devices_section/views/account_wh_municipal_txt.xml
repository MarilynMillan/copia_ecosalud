<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- vista lista para el modelo account.wh.municipal.txt-->
        <record id="view_wh_municipal_txt_tree" model="ir.ui.view">
            <field name="name">account.wh.municipal.txt_tree</field>
            <field name="model">account.wh.municipal.txt</field>
            <field name="arch" type="xml">
                <tree string="Municipal txt" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="amount_total"/>
                    <field name="state"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <!-- crear la vista formulario para el modelo account.wh.municipal.txt-->
        <record id="view_wh_municipal_txt_form" model="ir.ui.view">
            <field name="name">account.wh.municipal.txt_form</field>
            <field name="model">account.wh.municipal.txt</field>
            <field name="arch" type="xml">
                <form string="Municipal txt">
                    <header>
                        <button name="generate_txt" string="Generar TXT" type="object" class="oe_highlight" invisible="state in ('done','cancel')"/>
                        <button name="load_invoice" string="Cargar Facturas" type="object" class="oe_highlight" invisible="state in ('done','cancel')"/>
                        <button name="action_done" string="Marcar como Procesado" type="object" class="oe_highlight" invisible="state in ('done','cancel')" confirm="¿Está seguro que desea marcar como Procesado?"/>
                        <button name="action_cancel" string="Marcar como Anulado" type="object" class="oe_highlight" invisible="state in ('cancel')" confirm="¿Está seguro que desea marcar como Anulado?"/>
                        <button name="action_draft" string="Pasar a Borrador" type="object" invisible="state in ('draft','done')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="date_from" readonly="state in ('done','cancel')"/>
                                <field name="date_to" readonly="state in ('done','cancel')"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount_total"/>
                                <field name="txt_filename" invisible="1"/>
                                <field name="txt_file" filename="txt_filename"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="state in ('done','cancel')"/>
                                <field name="codigo_asignado"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Facturas con retenciones">
                                <field name="invoice_ids" nolabel="1" widget="one2many_list" readonly="state in ('done','cancel')">
                                    <tree string="Facturas">
                                        <field name="name"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="invoice_date"/>
                                        <field name="partner_id" string="Proveedor"/>
                                        <field name="tipo_contribuyente_mun" string="Tipo Contribuyente"/>
                                        <field name="codigo_asignado"/>
                                        <field name="amount_total"/>
                                        <field name="rate_value"/>
                                        <field name="porc_reten_muni"/>
                                        <field name="company_currency_id" column_invisible="1"/>
                                        <field name="monto_reten_muni" sum="Total Retenido"/>
                                        <field name="wh_muni_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                          <field name="message_follower_ids" widget="mail_followers"/>
                          <field name="activity_ids" widget="mail_activity"/>
                          <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- accion para el modelo account.wh.municipal.txt -->
        <record id="action_wh_municipal_txt" model="ir.actions.act_window">
            <field name="name">Municipal txt</field>
            <field name="res_model">account.wh.municipal.txt</field>
            <field name="view_mode">tree,form</field>

        </record>

        <!-- menu para el modelo account.wh.municipal.txt -->
        <menuitem id="menu_wh_municipal_txt" name="Generar TXT IAE" parent="l10n_ve_full.menu_venezuela_reporting" sequence="2" action="action_wh_municipal_txt"/>
    </data>
</odoo>