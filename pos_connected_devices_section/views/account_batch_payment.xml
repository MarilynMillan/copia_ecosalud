<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="l10n_batch_payment_form_inherit" model="ir.ui.view">
			<field name="name">l10n.account.batch.payment.form.inherit</field>
			<field name="model">account.batch.payment</field>
			<field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='state']" position="before">
					<button string="Generate txt" name="generate_file_txt" type="object" class="oe_highlight" invisible="state != 'sent'"/>
				</xpath>
				<xpath expr="//field[@name='name']" position="after">
					<field name="file_name" invisible="1"/>
					<field name="file_txt" groups="base.group_no_one" readonly="1" filename="file_name"/>
				</xpath>
			</field>
		</record>
	</data>
</odoo>